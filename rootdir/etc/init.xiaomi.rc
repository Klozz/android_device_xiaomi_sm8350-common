on boot
    # Fast Charge
    chown system system /sys/class/qcom-battery/restrict_chg
    chmod 0666 /sys/class/qcom-battery/restrict_chg

    # Setup ZRAM
    write /sys/block/zram0/reset 1
    write /sys/block/zram0/comp_algorithm lz4

on property:vendor.post_boot.parsed=1
    # Setup dex2oat thread count and cpuset
    setprop dalvik.vm.dex2oat-cpu-set 0,1,2,3,4,5,6
    setprop dalvik.vm.dex2oat-threads 6

    # optimize for some games
    write /proc/sys/kernel/sched_lib_name "audioserver, libaudioflinger.so, com.miHoYo., com.activision., UnityMain, libunity.so, libil2cpp.so, libfb.so"
    write /proc/sys/kernel/sched_lib_mask_force 240

    # Dynamically set IRQ affinity for KGSL and DRM
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.xiaomi_sm8350.sh

    # Force GPU to stay in higher performance levels
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 2
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

    # More aggressive on big cores
    write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/up_rate_limit_us 85
    write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/down_rate_limit_us 500
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/up_rate_limit_us 85
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/down_rate_limit_us 500

    # Enable touch boost to improve sysui
    write /sys/module/cpu_boost/parameters/input_boost_freq "0:1036800 1:1036800"
    write /sys/module/cpu_boost/parameters/input_boost_ms 80

    # Boostear foreground y top-app
    write /dev/stune/top-app/schedtune.boost 1
    write /dev/stune/foreground/schedtune.boost 1

    # Priorizar audio ensures top-app and audio go to bigs
    write /dev/cpuset/foreground/cpus 4-7
    write /dev/cpuset/top-app/cpus 4-7

    # Prevents little cores from being suspended too fast
    write /sys/devices/system/cpu/cpu0/online 1
    write /sys/devices/system/cpu/cpu0/cpuidle/state1/disable 0

    # Screen off ratelimits
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us_screen_off 2000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us_screen_off 2000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/up_rate_limit_us_screen_off 2000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/down_rate_limit_us_screen_off 2000
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/up_rate_limit_us_screen_off 2000
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/down_rate_limit_us_screen_off 2000

    # Yuki optimizations
	# Prefer to schedule top-app tasks on idle CPUs
	write /dev/stune/top-app/schedtune.prefer_idle 1

    # Workqueue Affinity to reduce jitter 
	# Set to cpu 0-3 and more conservative
	# https://bitsum.com/tools/cpu-affinity-calculator/
    write /sys/devices/virtual/workqueue/cpumask 3

	# Start blocking writeback later
	write /proc/sys/vm/dirty_ratio 30

	# Enable Explicit Congestion Control
	write /proc/sys/net/ipv4/tcp_ecn 1

	# Enable fast socket open for receiver and sender
	write /proc/sys/net/ipv4/tcp_fastopen 3

	# Limit max perf event processing time to this much CPU usage
    write /proc/sys/kernel/perf_cpu_time_max_percent 15

	# Execute child process before parent after fork
	write /proc/sys/kernel/sched_child_runs_first 1

	# Always allow sched boosting on top-app tasks
	write /proc/sys/kernel/sched_min_task_util_for_colocation 0

on property:dalvik.vm.heapstartsize=16
   write /proc/sys/vm/watermark_boost_factor 0
