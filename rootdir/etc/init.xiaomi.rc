on boot
    # Fast Charge
    chown system system /sys/class/qcom-battery/restrict_chg
    chmod 0666 /sys/class/qcom-battery/restrict_chg

on property:vendor.post_boot.parsed=1
    # Setup dex2oat thread count and cpuset
    setprop dalvik.vm.dex2oat-cpu-set 0,1,2,3,4,5,6
    setprop dalvik.vm.dex2oat-threads 6

    # optimize for some games
    write /proc/sys/kernel/sched_lib_name "com.miHoYo., com.activision., UnityMain, libunity.so, libil2cpp.so, libfb.so"
    write /proc/sys/kernel/sched_lib_mask_force 240

    # Dynamically set IRQ affinity for KGSL and DRM
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.xiaomi_sm8350.sh

on property:dalvik.vm.heapstartsize=16
   write /proc/sys/vm/watermark_boost_factor 0
