type hal_xperience_fastcharge_default, domain;
hal_server_domain(hal_xperience_fastcharge_default, hal_xperience_fastcharge)

type hal_xperience_fastcharge_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_xperience_fastcharge_default)

# HWBinder IPC from client to server
binder_call(hal_xperience_fastcharge_client, hal_xperience_fastcharge_server)

add_hwservice(hal_xperience_fastcharge_server, hal_xperience_fastcharge_hwservice)
allow hal_xperience_fastcharge_client hal_xperience_fastcharge_hwservice:hwservice_manager find;

# Allow binder communication with platform_app
binder_call(hal_xperience_fastcharge, platform_app)

get_prop(hal_xperience_fastcharge, vendor_fastcharge_prop)
set_prop(hal_xperience_fastcharge, vendor_fastcharge_prop)

# Fast Charge Node Service Permissions
allow hal_xperience_fastcharge_default sysfs_battery_supply:dir search;
allow hal_xperience_fastcharge_default sysfs_battery_supply:file rw_file_perms;

allow hal_xperience_fastcharge_default vendor_sysfs_battery_supply:dir search;
allow hal_xperience_fastcharge_default vendor_sysfs_battery_supply:file rw_file_perms;
